{
  "appId": "org.qortal.Qortal-Hub",
  "productName": "qortal-hub",
  "copyright": "Copyright © 2021 - 2025 Qortal",
  "compression": "normal",
  "asar": true,
  "afterPack": "scripts/afterPack.js",
  "extraResources": [
    {
      "from": "resources/private-transport",
      "to": "private-transport",
      "filter": ["**/qortal-private-transport"]
    },
    {
      "from": "resources/presence_bridge.py",
      "to": "reticulum/presence_bridge.py"
    },
    {
      "from": "resources/qortal_python_diagnostics.py",
      "to": "reticulum/qortal_python_diagnostics.py"
    },
    {
      "from": "resources/sitecustomize.py",
      "to": "reticulum/sitecustomize.py"
    },
    {
      "from": "resources/qortalland_games.py",
      "to": "reticulum/qortalland_games.py"
    },
    {
      "from": "resources/qortalland_proximity.py",
      "to": "reticulum/qortalland_proximity.py"
    },
    {
      "from": "resources/mesh-network.identity",
      "to": "reticulum/mesh-network.identity"
    },
    {
      "from": "resources/mesh-network.passphrase",
      "to": "reticulum/mesh-network.passphrase"
    },
    {
      "from": "resources/reticulum",
      "to": "reticulum",
      "filter": [
        "**/*",
        "!presence_bridge.py",
        "!qortal_python_diagnostics.py",
        "!sitecustomize.py",
        "!qortalland_games.py",
        "!qortalland_proximity.py",
        "!mesh-network.identity",
        "!mesh-network.passphrase",
        "!__pycache__/**",
        "!**/__pycache__/**",
        "!**/*.pyc",
        "!test-darwin-*"
      ]
    }
  ],
  "files": [
    "assets/**/*",
    "build/**/*",
    "capacitor.config.*",
    "app/**/*",
    "scripts/**/*"
  ],
  "asarUnpack": [
    "**/*.node",
    "node_modules/@img/sharp-*/**/*",
    "node_modules/bindings/**/*",
    "node_modules/file-uri-to-path/**/*",
    "build/src/ed25519-verify.worker.js",
    "build/src/reticulum-chat.worker.js",
    "build/src/reticulum-resource.worker.js",
    "build/src/reticulum-media.worker.js"
  ],
  "linux": {
    "target": ["AppImage", "deb", "snap", "rpm"],
    "category": "Network",
    "packageCategory": "Network",
    "desktop": {
      "entry": {
        "Name": "Qortal Hub",
        "StartupWMClass": "qortal-hub"
      }
    },
    "executableName": "qortal-hub",
    "icon": "assets/png"
  },
  "appImage": {
    "artifactName": "Qortal-Hub.${ext}"
  },
  "deb": {
    "artifactName": "Qortal-Hub-Setup.${ext}",
    "synopsis": "Qortal Hub for Linux",
    "afterInstall": "scripts/add-debian-apt-repo.sh"
  },
  "snap": {
    "artifactName": "Qortal-Hub-Setup.${ext}",
    "synopsis": "Qortal Hub for Linux"
  },
  "rpm": {
    "artifactName": "Qortal-Hub-Setup.${ext}",
    "synopsis": "Qortal Hub for Linux"
  },
  "directories": {
    "output": "dist",
    "buildResources": "resources"
  },
  "publish": [
    {
      "provider": "github",
      "owner": "Qortal",
      "repo": "Qortal-Hub",
      "releaseType": "draft"
    }
  ]
}
